  "statusTones": {
    "$description": "Tono visual por código de estado. Es presentación, no lógica de negocio: un código desconocido usa 'neutral', así que un estado nuevo en el backend nunca rompe la interfaz. Ver design/README.md, sección 'Estados'.",
    "application": {
      "DRAFT": "neutral",
      "WAITING_BUYER_DATA": "warning",
      "WAITING_DOCUMENTS": "warning",
      "DOCUMENTS_REVIEW": "info",
      "READY_TO_FILE": "accent",
      "FILED": "info",
      "FILING_VALIDATION": "info",
      "CREDIT_ANALYSIS": "info",
      "APPROVED": "success",
      "LEGALIZATION": "success",
      "DISBURSED": "success",
      "REJECTED": "danger",
      "WITHDRAWN": "neutral",
      "CANCELLED": "neutral",
      "OWN_FUNDS": "neutral",
      "EXTERNAL_CREDIT_APPROVED": "neutral"
    },
    "documentSlot": {
      "PENDING": "neutral",
      "UPLOADED": "info",
      "APPROVED": "success",
      "REJECTED": "danger",
      "WAIVED": "accent"
