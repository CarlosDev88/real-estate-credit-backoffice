# Origen del backend al que el front reescribe /api/v1 (mismo origen para cookies y CSRF).
API_ORIGIN=http://localhost:8000

# Usuario de prueba para los E2E de Playwright. Los valores reales van en .env.local (no se versiona).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Nombres de las cookies de sesión que mira proxy.ts (opcional, separados por coma).
# Por defecto acepta las dos variantes: __Host-app_access,app_access y __Host-app_refresh,app_refresh.
# AUTH_ACCESS_COOKIE=
# AUTH_REFRESH_COOKIE=
