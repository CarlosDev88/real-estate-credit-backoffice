# PostgreSQL
POSTGRES_DB=mvp_credit
POSTGRES_USER=mvp_credit_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_HOST_PORT=5433

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change_this_local_django_secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_HOST_PORT=8000

# Conexión interna entre contenedores
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=mvp_credit
DATABASE_USER=mvp_credit_user
DATABASE_PASSWORD=change_this_local_password
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Frontend (Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/restablecer-contrasena
INVITATION_ACCEPT_URL=http://localhost:3000/aceptar-invitacion
DEFAULT_FROM_EMAIL=no-responder@localhost

# Autenticación interna
# Genera una clave propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SIGNING_KEY=change_this_local_jwt_signing_key
# false solo en local (HTTP). En cualquier entorno con HTTPS debe ser true.
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_HOURS=8
AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
AUTH_INVITATION_HOURS=72
# Cantidad de proxies de confianza delante de la API (0 = ignorar X-Forwarded-For).
NUM_PROXIES=0

# Buyer access (magic links and buyer sessions)
BUYER_ACCESS_LINK_DEFAULT_HOURS=72
BUYER_ACCESS_LINK_MAX_HOURS=168
BUYER_SESSION_HOURS=24
BUYER_ACCESS_URL=http://localhost:3000/acceso

# Expediente documental: almacenamiento S3 compatible (SeaweedFS en local)
DOCUMENT_STORAGE_BACKEND=s3
DOCUMENT_STORAGE_BUCKET=mvp-credit-documents
DOCUMENT_STORAGE_REGION=us-east-1
DOCUMENT_STORAGE_ENDPOINT_URL=http://seaweedfs:8333
DOCUMENT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:8333
DOCUMENT_STORAGE_ACCESS_KEY_ID=change-me-local-storage-key
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=change-me-local-storage-secret
DOCUMENT_STORAGE_ADDRESSING_STYLE=path
# Vacio en SeaweedFS (no implementa SSE); AES256 en S3 real.
DOCUMENT_STORAGE_SSE=
# Antivirus: clamd (perfil async). En desarrollo, sin el perfil async, usa DOCUMENT_SCANNER=fake (requiere DEBUG).
DOCUMENT_SCANNER=clamd
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=30
